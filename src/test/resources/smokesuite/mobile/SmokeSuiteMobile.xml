<?xml version="1.0" encoding="UTF-8"?>
<suite name="SanitySuite">
    <test name="SanityTestMobile">
        <parameter name="browser" value="chrome"/>
        <parameter name="browserSize" value="mobile"/>
        <classes>
            <class name="smoke.SmokeTestCasesMobile">
                <methods>
                    <include name="verifyMobileHomepageBannerCarouselSlideAutomatically"/>
                    <include name="verifySingleColumnLayoutForMobile"/>
                    <include name="verifyMobileMenutoHomepageNavigation"/>
                    <include name="verifyMobileSubscribeButtonInactiveWhenMandatoryFieldsInvalid"/>
                    <include name="verifyMobileSubscribeButtonDisabled"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>