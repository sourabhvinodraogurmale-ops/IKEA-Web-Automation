<?xml version="1.0" encoding="UTF-8"?>
<suite name="SanitySuite">
    <test name="SanityTestMobile">
        <parameter name="browser" value="chrome"/>
        <parameter name="browserSize" value="desktop"/>
        <classes>
            <class name="smoke.SmokeTestCases">
                <methods>
                    <include name="verifyHomePageLoads"/>
                    <include name="verifyCookiesAcceptAllOption"/>
                    <include name="verifyViewOnMapOptionDisplayed"/>
                    <include name="verifyShopListingPage"/>
                    <include name="verifyShopsWithOffersIndicator"/>
                    <include name="verifyLogoDisplayedTopLeft"/>
                    <include name="verifyTodaysOpeningTimeAndMeetingPlaceNameDisplayedTopRight"/>
                    <include name="verifyShowMoreButtonDisplaysMoreCards"/>
                    <include name="verifyMenuNavigation"/>
                    <include name="VerifyFooterLinks"/>
                    <include name="verifyWebMpMenuLogoClickable"/>
                    <include name="verifyWebSubscribeButtonInactiveWhenMandatoryFieldsInvalid"/>
                    <include name="verifyWebSubscribeButtonDisabled"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>